#!/bin/bash

### 卸载后回调
### wizard_delete_data="true"  → 删除全部数据（含 Runtime、Skills、CLI 与用户数据）
### wizard_delete_data="false" → 保留全部（升级/重装时不破坏环境）

TRIM_PKGHOME="${TRIM_PKGHOME:-}"
TRIM_PKGVAR="${TRIM_PKGVAR:-}"
TRIM_APPNAME="${TRIM_APPNAME:-HStudio}"
wizard_delete_data="${wizard_delete_data:-false}"

[ -z "$TRIM_PKGHOME" ] && exit 0

case "$TRIM_APPNAME" in
    ""|.|..|*/*|*\\*) exit 1 ;;
esac

canonical_owned_root() {
    local target="$1" expected_parent="$2" resolved parent
    case "$target" in /*) ;; *) return 1 ;; esac
    resolved="$(readlink -f -- "$target" 2>/dev/null)" || return 1
    [ -d "$resolved" ] || return 1
    [ "$(basename -- "$resolved")" = "$TRIM_APPNAME" ] || return 1
    parent="$(dirname -- "$resolved")"
    [ "$(basename -- "$parent")" = "$expected_parent" ] || return 1
    printf '%s\n' "$resolved"
}

if [ "$wizard_delete_data" = "true" ]; then
    # Resolve and validate every target before deleting either one. fnOS may
    # place the application on any volume, but the physical ownership boundary
    # is always .../@apphome/<app> and .../@appdata/<app>.
    home_target=""
    var_target=""
    if [ -e "$TRIM_PKGHOME" ] || [ -L "$TRIM_PKGHOME" ]; then
        home_root="$(canonical_owned_root "$TRIM_PKGHOME" @apphome)" || exit 1
        candidate="${home_root}/data"
        if [ -e "$candidate" ] || [ -L "$candidate" ]; then
            [ ! -L "$candidate" ] || exit 1
            home_target="$(readlink -f -- "$candidate" 2>/dev/null)" || exit 1
            [ -d "$home_target" ] && [ "$home_target" = "${home_root}/data" ] || exit 1
        fi
    fi
    if [ -n "$TRIM_PKGVAR" ] && { [ -e "$TRIM_PKGVAR" ] || [ -L "$TRIM_PKGVAR" ]; }; then
        var_target="$(canonical_owned_root "$TRIM_PKGVAR" @appdata)" || exit 1
    fi

    [ -z "$home_target" ] || rm -rf -- "$home_target" || exit 1
    [ -z "$var_target" ] || rm -rf -- "$var_target" || exit 1
fi

exit 0
