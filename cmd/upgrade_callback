#!/bin/bash
# FPK upgrade callback. Adapter files may change; all user state stays in HOME.
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
mkdir -p "${TRIM_PKGVAR:-$ROOT/var}" 2>/dev/null || true
printf '%s [upgrade] FPK adapter upgraded; .npm-global and user config preserved\n' "$(date '+%Y-%m-%d %H:%M:%S')" >> "${TRIM_PKGVAR:-$ROOT/var}/info.log" 2>/dev/null || true
