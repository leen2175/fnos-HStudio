#!/bin/bash
# Install callback: bootstrap only the bundled fallback. User npm global data is
# deliberately never removed, so App updates and credentials survive FPK upgrades.
set +u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
APP_DIR="${TRIM_APPDEST:-$ROOT}"
TRIM_APPDEST="$APP_DIR"
TRIM_PKGHOME="${TRIM_PKGHOME:-${APP_DIR}/home}"
DATA_DIR="${TRIM_PKGHOME}/data"
export TRIM_APPDEST TRIM_PKGHOME DATA_DIR
. "$ROOT/cmd/lib/environment.sh"
. "$ROOT/cmd/lib/runtime.sh"
. "$ROOT/cmd/lib/migration.sh"
. "$ROOT/cmd/lib/download.sh"
init_environment
LOG_FILE="${TRIM_PKGVAR:-${APP_DIR}/var}/info.log"; mkdir -p "$(dirname "$LOG_FILE")"
log_msg() { printf '%s [install] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" | tee -a "$LOG_FILE" >/dev/null; }
BOOTSTRAP_STATE_FILE="${DATA_DIR}/manager/runtime-bootstrap.json"
BOOTSTRAP_NPM_STAGE_PATH=""
BOOTSTRAP_NPM_ARCHIVE_PATH=""

cleanup_bootstrap_transients() {
    local path parent name
    cleanup_runtime_install_transients
    for path in "${BOOTSTRAP_NPM_STAGE_PATH:-}" "${BOOTSTRAP_NPM_ARCHIVE_PATH:-}"; do
        [ -n "$path" ] || continue
        parent="$(dirname -- "$path")"
        name="$(basename -- "$path")"
        [ "$parent" = "$runtime_bundled_root" ] || continue
        case "$name" in
            .npm-stage.*."$$".*) rm -rf -- "$path" ;;
            .npm-runtime.*."$$".*.tar.gz) rm -f -- "$path" ;;
        esac
    done
    BOOTSTRAP_NPM_STAGE_PATH=""
    BOOTSTRAP_NPM_ARCHIVE_PATH=""
}
# Invoked indirectly by the EXIT trap below.
# shellcheck disable=SC2317
bootstrap_terminal() {
    local exit_code="$1" status tmp
    [ "${HSTUDIO_RUNTIME_BOOTSTRAP:-0}" = "1" ] || return 0
    if [ "$exit_code" -eq 0 ]; then status=success; else status=failed; fi
    tmp="${BOOTSTRAP_STATE_FILE}.tmp.$$"
    mkdir -p "$(dirname "$BOOTSTRAP_STATE_FILE")" 2>/dev/null || return 0
    printf '{"status":"%s","exitCode":%s,"updatedAt":"%s"}\n' \
        "$status" "$exit_code" "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" > "$tmp" 2>/dev/null || return 0
    mv -f "$tmp" "$BOOTSTRAP_STATE_FILE" 2>/dev/null || true
}
bootstrap_phase() {
    local phase="$1" message="${2:-}" tmp="${BOOTSTRAP_STATE_FILE}.tmp.$$" callback_start
    callback_start="$(awk '{print $22}' "/proc/$$/stat" 2>/dev/null || true)"
    mkdir -p "$(dirname "$BOOTSTRAP_STATE_FILE")"
    printf '{"status":"running","phase":"%s","message":"%s","callbackPid":%s,"callbackStartTime":"%s","callbackDataDir":"%s","updatedAt":"%s"}\n' \
        "$(json_escape "$phase")" "$(json_escape "$message")" "$$" \
        "$(json_escape "$callback_start")" "$(json_escape "$DATA_DIR")" \
        "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" > "$tmp"
    mv -f "$tmp" "$BOOTSTRAP_STATE_FILE"
}
fail() {
    local message="$1" temp_log="${TRIM_TEMP_LOGFILE:-${APP_DIR}/install-error.log}"
    log_msg "$message"
    mkdir -p "$(dirname "$temp_log")" 2>/dev/null || true
    printf '%s\n' "$message" > "$temp_log" 2>/dev/null || true
    exit 1
}
bootstrap_exit() {
    local exit_code="$1"
    trap - EXIT
    cleanup_bootstrap_transients
    bootstrap_terminal "$exit_code"
}
trap 'bootstrap_exit "$?"' EXIT
bootstrap_interrupted() {
    # Bash defers a trapped signal while waiting for the foreground bounded
    # supervisor. Exiting here therefore keeps the callback identity alive
    # until that supervisor has removed its detached npm process group.
    trap - TERM INT
    exit 143
}
trap bootstrap_interrupted TERM INT

find_trim_cli_skill() {
    local candidate
    if [ -n "${HSTUDIO_SKILLS_DIR:-}" ] \
        && [ -f "$HSTUDIO_SKILLS_DIR/trim-cli/SKILL.md" ] \
        && [ -f "$HSTUDIO_SKILLS_DIR/trim-cli/scripts/trim-cli" ] \
        && [ -f "$HSTUDIO_SKILLS_DIR/trim-cli/bin/trim-cli-linux-x64" ] \
        && [ -f "$HSTUDIO_SKILLS_DIR/trim-cli/bin/trim-cli-linux-arm64" ]; then
        printf '%s\n' "$HSTUDIO_SKILLS_DIR/trim-cli"
        return 0
    fi
    for candidate in \
        "${APP_DIR}/skills/trim-cli" \
        "${APP_DIR}/app/skills/trim-cli" \
        "${APP_DIR}/.agents/skills/trim-cli"; do
        [ -n "$candidate" ] || continue
        if [ -f "$candidate/SKILL.md" ] \
            && [ -f "$candidate/scripts/trim-cli" ] \
            && [ -f "$candidate/bin/trim-cli-linux-x64" ] \
            && [ -f "$candidate/bin/trim-cli-linux-arm64" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

install_skill_if_missing() {
    local source="$1" parent="$2" label="$3" target="${2}/trim-cli" stage
    mkdir -p "$parent" || return 1
    if [ -e "$target" ] || [ -L "$target" ]; then
        if [ -f "$target/SKILL.md" ]; then
            log_msg "trim-cli Skill already present for ${label}; preserving existing copy"
        else
            log_msg "trim-cli target for ${label} already exists but is incomplete; preserving it"
        fi
        return 0
    fi
    stage="${parent}/.trim-cli.hstudio.$$"
    (umask 077; mkdir "$stage") || return 1
    if ! cp -R "$source"/. "$stage"/; then
        rm -rf -- "$stage"
        return 1
    fi
    chmod 755 "$stage/scripts/trim-cli" "$stage/bin/trim-cli-linux-x64" \
        "$stage/bin/trim-cli-linux-arm64" 2>/dev/null || true
    if ! mv "$stage" "$target"; then
        rm -rf -- "$stage"
        return 1
    fi
    log_msg "installed trim-cli Skill for ${label} at ${target}"
}

install_bundled_trim_cli() {
    local source cli_source cli_stage machine
    source="$(find_trim_cli_skill 2>/dev/null || true)"
    [ -n "$source" ] || return 1
    machine="$(uname -m 2>/dev/null || true)"
    case "$machine" in
        x86_64|amd64) cli_source="$source/bin/trim-cli-linux-x64" ;;
        aarch64|arm64) cli_source="$source/bin/trim-cli-linux-arm64" ;;
        *) log_msg "unsupported trim-cli architecture: ${machine:-unknown}"; return 1 ;;
    esac
    [ -s "$cli_source" ] || return 1

    mkdir -p "$HSTUDIO_TOOLS_BIN" || return 1
    cli_stage="${TRIM_CLI_BIN}.tmp.$$"
    if ! cp "$cli_source" "$cli_stage"; then
        rm -f -- "$cli_stage"
        return 1
    fi
    chmod 755 "$cli_stage" || { rm -f -- "$cli_stage"; return 1; }
    mv -f "$cli_stage" "$TRIM_CLI_BIN" || { rm -f -- "$cli_stage"; return 1; }

    install_skill_if_missing "$source" "$HERMES_HOME/skills" "Hermes default profile" || return 1
    install_skill_if_missing "$source" "$HOME/.agents/skills" "Codex/Pi" || return 1
    install_skill_if_missing "$source" "$HOME/.claude/skills" "Claude Code" || return 1
    log_msg "trim-cli CLI for ${machine} installed at ${TRIM_CLI_BIN}"
}

log_msg "install context appdest=${APP_DIR} pkgetc=${TRIM_PKGETC:-<unset>} pkghome=${TRIM_PKGHOME} node=${NODE_BIN:-<missing>}"
install_bundled_trim_cli || fail 'bundled trim-cli Skill or matching Linux CLI is missing or could not be installed'

# App Center must be able to finish package installation even when the device
# cannot reach GitHub. Runtime provisioning is retried by Manager explicitly;
# the ordinary lifecycle callback only prepares persistent directories.
if [ "${HSTUDIO_RUNTIME_BOOTSTRAP:-0}" != "1" ]; then
    mkdir -p "$DATA_DIR" "$NPM_GLOBAL" "$HERMES_WEB_UI_HOME" 2>/dev/null || true
    log_msg 'install complete; Runtime bootstrap deferred to Manager'
    exit 0
fi

CONFIG_DIR=""
for candidate in "${TRIM_PKGETC:-}/bootstrap" "$ROOT/config/bootstrap" "$APP_DIR/config/bootstrap" "$APP_DIR/app/config/bootstrap" "$(dirname "$APP_DIR")/config/bootstrap" "$ROOT/../config/bootstrap"; do
    if [ -f "$candidate/hermes-studio-version.env" ]; then CONFIG_DIR="$(dirname "$candidate")"; break; fi
done
VERSION_ENV="${CONFIG_DIR:+$CONFIG_DIR/bootstrap/}hermes-studio-version.env"
if [ -z "$CONFIG_DIR" ] || [ ! -f "$VERSION_ENV" ]; then
    fail 'missing Hermes version metadata'
fi
RUNTIME_MANIFEST=""
for candidate in "$CONFIG_DIR/runtime-manifest.json" "${TRIM_PKGETC:-}/runtime-manifest.json" "$ROOT/config/runtime-manifest.json" "$ROOT/etc/runtime-manifest.json" "$APP_DIR/config/runtime-manifest.json" "$APP_DIR/etc/runtime-manifest.json" "$APP_DIR/app/config/runtime-manifest.json" "$APP_DIR/../etc/runtime-manifest.json" "$ROOT/../config/runtime-manifest.json"; do
    if [ -f "$candidate" ]; then RUNTIME_MANIFEST="$candidate"; break; fi
done
# shellcheck source=/dev/null
. "$VERSION_ENV"
[ -n "${HERMES_STUDIO_VERSION:-}" ] || fail 'invalid Hermes version metadata'
NODE_VERSION="${NODE_BIN:+$($NODE_BIN --version 2>/dev/null || true)}"
NODE_MAJOR="$(printf '%s\n' "$NODE_VERSION" | sed -nE 's/^v([0-9]+).*$/\1/p')"
[ "${NODE_MAJOR:-0}" = 24 ] || fail "fnOS nodejs_v24 is required (selected ${NODE_BIN:-<missing>} reports ${NODE_VERSION:-unknown})"
[ -n "$RUNTIME_MANIFEST" ] && [ -f "$RUNTIME_MANIFEST" ] && [ -r "$RUNTIME_MANIFEST" ] \
    || fail 'missing or unreadable Runtime manifest'
manifest_values="$($NODE_BIN -e '
const fs=require("node:fs")
try {
  const value=JSON.parse(fs.readFileSync(process.argv[2],"utf8"))
  const studio=value&&value.studio
  const semver=/^(?:0|[1-9]\d*)\.(?:0|[1-9]\d*)\.(?:0|[1-9]\d*)(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?(?:\+[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$/
  if(!studio||!semver.test(studio.version)||!/^[0-9a-f]{64}$/i.test(studio.sha256)||!Number.isSafeInteger(studio.size)||studio.size<1)process.exit(2)
  process.stdout.write(`${studio.version}\n${studio.sha256.toLowerCase()}\n${studio.size}\n`)
} catch { process.exit(2) }
' hstudio-runtime-manifest "$RUNTIME_MANIFEST" 2>/dev/null)" \
    || fail 'invalid Runtime manifest: studio.version, sha256 and size must be locked'
mapfile -t manifest_fields <<< "$manifest_values"
[ "${#manifest_fields[@]}" -eq 3 ] || fail 'invalid Runtime manifest fields'
RUNTIME_MANIFEST_VERSION="${manifest_fields[0]}"
RUNTIME_MANIFEST_SHA256="${manifest_fields[1]}"
RUNTIME_MANIFEST_SIZE="${manifest_fields[2]}"
[ "$RUNTIME_MANIFEST_VERSION" = "$HERMES_STUDIO_VERSION" ] \
    || fail 'Hermes version metadata does not match Runtime manifest'

ensure_bundled_runtime() {
    local offline_only="${1:-0}" version target current current_version archive_found=0 archive_bytes
    local npm_stage npm_package npm_archive npm_hash expected reason archive
    local -a local_urls
    version="${HERMES_STUDIO_VERSION}"
    target="${DATA_DIR}/runtime/studio/${version}"
    current="$(current_bundled_entry 2>/dev/null || true)"
    if [ -n "$current" ] && health_check_runtime "$current"; then
        current_version="$(runtime_package_version "$(runtime_package_root "$current")" 2>/dev/null || true)"
        if [ "$current_version" = "$version" ]; then
            log_msg "bundled runtime ${version} already active at its verified current target"
            return 0
        fi
    fi
    if health_check_runtime "$target/bin/hermes-web-ui"; then
        if activate_bundled_runtime "$version"; then
            log_msg "bundled runtime ${version} already present and active"; return 0
        fi
        log_msg "bundled runtime ${version} exists but current/previous pointer repair failed"
        return 1
    fi
    mkdir -p "${runtime_bundled_root}"
    bootstrap_phase archive-search "Searching Offline Runtime in installed application files"
    for archive in "$ROOT"/cmd/bootstrap/hermes-studio-runtime-*.tar.gz "$ROOT"/runtime/hermes-studio-runtime-*.tar.gz "$ROOT"/config/bootstrap/hermes-studio-runtime-*.tar.gz "$ROOT"/bootstrap/hermes-studio-runtime-*.tar.gz "$APP_DIR"/runtime/hermes-studio-runtime-*.tar.gz "$APP_DIR"/app/runtime/hermes-studio-runtime-*.tar.gz "$APP_DIR"/config/bootstrap/hermes-studio-runtime-*.tar.gz "$APP_DIR"/bootstrap/hermes-studio-runtime-*.tar.gz "$APP_DIR"/../runtime/hermes-studio-runtime-*.tar.gz "${TRIM_PKGHOME:-}"/runtime/hermes-studio-runtime-*.tar.gz; do
        [ -f "$archive" ] || continue
        archive_found=1
        archive_bytes="$(stat -c '%s' "$archive" 2>/dev/null || true)"
        log_msg "found package Runtime archive path=${archive} bytes=${archive_bytes:-unknown}"
        bootstrap_phase archive-install "Installing verified Runtime from FPK"
        if [ "$archive_bytes" != "$RUNTIME_MANIFEST_SIZE" ]; then
            reason=size
            bootstrap_phase archive-rejected "Offline Runtime rejected: ${reason}"
            log_msg "package Runtime archive rejected path=${archive} reason=${reason}; expected bytes=${RUNTIME_MANIFEST_SIZE}"
            continue
        fi
        if install_runtime_archive "$archive" "$version" "$RUNTIME_MANIFEST_SHA256"; then
            log_msg "bundled runtime ${version} installed from package archive"; return 0
        fi
        reason="${RUNTIME_ARCHIVE_ERROR:-unknown}"
        bootstrap_phase archive-rejected "Offline Runtime rejected: ${reason}"
        log_msg "package Runtime archive rejected path=${archive} reason=${reason}; verify checksum, layout and free space"
    done
    [ "$archive_found" -eq 1 ] || log_msg "package Runtime archive not found under lifecycle=${ROOT} appdest=${APP_DIR} pkgetc=${TRIM_PKGETC:-<unset>}"
    # A healthy user-selected Runtime must not trigger network activity during
    # an FPK upgrade. Still consume a packaged archive when one is present so
    # the bundled fallback is refreshed without changing Runtime preference.
    if [ "$offline_only" = "1" ]; then
        if [ "$archive_found" -eq 0 ]; then
            return 0
        fi
        return 1
    fi
    if [ ! -e "$target/bin/hermes-web-ui" ] && [ ! -e "$target/bin/hermes-web-ui.mjs" ]; then
        mapfile -t local_urls < <(sed -n '/"urls"[[:space:]]*:/,/]/p' "$RUNTIME_MANIFEST" 2>/dev/null | sed -nE 's/.*"(https?:[^" ]+)".*/\1/p')
        expected="$RUNTIME_MANIFEST_SHA256"
        bootstrap_phase archive-download "Downloading verified GitHub Runtime archive"
        if [ "${#local_urls[@]}" -gt 0 ] && download_with_resume "$DATA_DIR/cache/downloads/${version}.tar.gz" "$expected" "$RUNTIME_MANIFEST_SIZE" "${local_urls[@]}"; then
            bootstrap_phase archive-install "Verifying and installing Runtime archive"
            archive_bytes="$(stat -c '%s' "$DATA_DIR/cache/downloads/${version}.tar.gz" 2>/dev/null || true)"
            if [ "$archive_bytes" = "$RUNTIME_MANIFEST_SIZE" ]; then
                install_runtime_archive "$DATA_DIR/cache/downloads/${version}.tar.gz" "$version" "$expected" && return 0
            else
                rm -f -- "$DATA_DIR/cache/downloads/${version}.tar.gz"
                log_msg "downloaded Runtime size mismatch expected=${RUNTIME_MANIFEST_SIZE} actual=${archive_bytes:-unknown}"
            fi
        fi
    fi
    if [ -x "${NPM_BIN:-}" ]; then
        bootstrap_phase npm-install "GitHub archive unavailable; installing from npm registry"
        npm_stage="${runtime_bundled_root}/.npm-stage.${version}.$$.${RANDOM}"
        npm_archive="${runtime_bundled_root}/.npm-runtime.${version}.$$.${RANDOM}.tar.gz"
        BOOTSTRAP_NPM_STAGE_PATH="$npm_stage"
        BOOTSTRAP_NPM_ARCHIVE_PATH="$npm_archive"
        npm_package="${npm_stage}/lib/node_modules/hermes-web-ui"
        log_msg "archive unavailable; trying isolated npm fallback hermes-web-ui@${version}"
        (umask 077; mkdir -p "$npm_stage") || return 1
        export HOME="$DATA_DIR" \
            npm_config_prefix="$npm_stage" NPM_CONFIG_PREFIX="$npm_stage" \
            npm_config_userconfig="$npm_stage/.npmrc" NPM_CONFIG_USERCONFIG="$npm_stage/.npmrc" \
            npm_config_fetch_retries=3 npm_config_fetch_retry_mintimeout=2000 npm_config_fetch_retry_maxtimeout=15000
        if run_command_bounded "$NODE_BIN" 900000 "$NPM_BIN" install --global --prefix "$npm_stage" \
            --no-audit --no-fund "hermes-web-ui@${version}" >> "$LOG_FILE" 2>&1; then
            if [ -d "$npm_package" ] \
                && tar -czf "$npm_archive" -C "${npm_stage}/lib/node_modules" hermes-web-ui >> "$LOG_FILE" 2>&1; then
                if command -v sha256sum >/dev/null 2>&1; then
                    npm_hash="$(sha256sum "$npm_archive" | awk '{print $1}')"
                else
                    npm_hash="$(shasum -a 256 "$npm_archive" | awk '{print $1}')"
                fi
                if [ -n "$npm_hash" ] && install_runtime_archive "$npm_archive" "$version" "$npm_hash"; then
                    rm -rf -- "$npm_stage"
                    rm -f -- "$npm_archive"
                    BOOTSTRAP_NPM_STAGE_PATH=""
                    BOOTSTRAP_NPM_ARCHIVE_PATH=""
                    log_msg "isolated npm runtime ${version} verified and published as bundled Runtime"
                    return 0
                fi
                log_msg "isolated npm Runtime rejected for hermes-web-ui@${version} reason=${RUNTIME_ARCHIVE_ERROR:-health}"
            fi
        fi
        rm -rf -- "$npm_stage"
        rm -f -- "$npm_archive"
        BOOTSTRAP_NPM_STAGE_PATH=""
        BOOTSTRAP_NPM_ARCHIVE_PATH=""
        log_msg "isolated npm fallback failed for hermes-web-ui@${version}"
    fi
    if [ "${HSTUDIO_RUNTIME_BOOTSTRAP:-0}" = "1" ]; then
        fail 'GitHub Runtime archive and npm registry fallback both failed; inspect Runtime bootstrap log'
    fi
    # Lite packages intentionally allow first boot without network access.
    # Manager retries this bootstrap after installation instead of making App
    # Center reject the whole package.
    log_msg 'bundled runtime not available; deferring download to Manager'
    return 0
}

mkdir -p "$DATA_DIR" "$NPM_GLOBAL" "$HERMES_WEB_UI_HOME"
migrate_legacy_runtime || true
# An FPK upgrade refreshes an included bundled fallback, but never changes or
# replaces a healthy user-global Runtime and never performs network fallback
# merely because a healthy user Runtime is older than the bundled version.
if health_check_runtime "$runtime_user_bin"; then
    ensure_bundled_runtime 1 || fail 'packaged Runtime archive was found but could not be verified and installed'
    log_msg "healthy user Runtime ${runtime_user_bin} preserved as preferred auto Runtime"
else
    ensure_bundled_runtime
fi
# Keep npm prefix explicit for Hermes' own update/upgrade commands.
cat > "$DATA_DIR/.npmrc" <<EOF
prefix=${NPM_GLOBAL}
cache=${npm_config_cache}
registry=${NPM_REGISTRY}
EOF
chmod 600 "$DATA_DIR/.npmrc" 2>/dev/null || true
log_msg "install complete; user runtime preserved at ${NPM_GLOBAL}"

# The bootstrap callback owns the completion handoff. This remains reliable if
# Manager is restarted while the download is in progress: a successful
# callback starts the now-healthy Runtime itself. The guarded lifecycle flag
# closes the check/start race with a concurrent fnOS stop or upgrade.
if [ "${HSTUDIO_RUNTIME_BOOTSTRAP:-0}" = "1" ] \
    && [ ! -e "${DATA_DIR}/manager/stopping" ]; then
    if ! HSTUDIO_BOOTSTRAP_START=1 "$ROOT/cmd/main" bootstrap-complete; then
        fail 'Runtime installed but HStudio could not start safely'
    fi
fi
exit 0
